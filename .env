MARGEM_SALDO_PLATAFORMA=0
CHECK_LINKS_FAIL_OPEN=false
LINK_CHECK_TIMEOUT=12


# ============================================================
# 7. PAGAMENTOS PENDENTES
# Use 0 para desativar. Padrão recomendado: 180 minutos / 3 horas.
# ============================================================
PAGAMENTOS_PENDENTES_EXPIRAR_MINUTOS=180
PAGAMENTOS_PENDENTES_LIMPEZA_INTERVALO=300


# ============================================================
# 8. CADASTRO / REGISTRO
# Tempo para tentar novo cadastro após o admin negar o registro.
# ============================================================
REGISTRO_NEGADO_TENTAR_NOVAMENTE_MINUTOS=5


# ============================================================
# 9. RAILWAY / SERVIDOR
# Normalmente o Railway cria PORT sozinho.
# Só use localmente se precisar forçar uma porta.
# ============================================================
# PORT=8080

# Remove pedidos salvos em pendentes quando o bot reinicia, evitando reenvio no Railway.
LIMPAR_PEDIDOS_PENDENTES_AO_INICIAR=true
